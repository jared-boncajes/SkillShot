# ---------------------------------------------------------------- server (runtime)
# Copy the values you need into your host's environment / dashboard.
PORT=2567
HOST=0.0.0.0
# Players needed before the host can start (use 1 to try the game alone).
MIN_PLAYERS=2
# Comma-separated list of browser origins allowed to connect. Empty = allow any.
ALLOWED_ORIGINS=
# Folder containing the built client to serve over HTTP. Leave unset to auto-detect ../client/dist.
# Set to an empty string to run the backend alone (no static files).
#CLIENT_DIST=
# Optional rule overrides (defaults come from shared/src/modes.ts)
#MATCH_DURATION_SEC=300
#SCORE_LIMIT=30
#RESPAWN_MS=3000
#SPAWN_PROTECTION_MS=2000
#COUNTDOWN_MS=5000
#RESULTS_MS=10000
#RECONNECT_GRACE_MS=30000
# Balance: override body-part damage multipliers without a rebuild.
#DAMAGE_MULTIPLIERS={"head":2.5,"torso":1,"arms":0.9,"legs":0.75,"feet":0.6}
# Set to 0 to silence connection logs.
#LOG=1

# ---------------------------------------------------------------- client (build time)
# Only needed when the frontend is hosted separately from the game server.
# http(s):// and ws(s):// are both accepted; https pages always connect with wss.
#VITE_SERVER_URL=https://your-game-server.example.com
